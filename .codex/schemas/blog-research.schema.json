{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "working_thesis": {
      "type": "string",
      "minLength": 1
    },
    "reader_value": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "required": ["claim", "why_it_matters", "evidence", "source_urls", "confidence"],
        "additionalProperties": false
      }
    },
    "counterpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point": { "type": "string", "minLength": 1 },
          "source_urls": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["point", "source_urls"],
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suggested_outline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["heading", "purpose", "points"],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "published_or_updated": { "type": "string" },
          "relevance": { "type": "string", "minLength": 1 }
        },
        "required": ["title", "url", "publisher", "published_or_updated", "relevance"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "working_thesis",
    "reader_value",
    "findings",
    "counterpoints",
    "open_questions",
    "suggested_outline",
    "sources"
  ],
  "additionalProperties": false
}
