{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["description", "categories", "tags", "body_markdown"],
  "additionalProperties": false
}
